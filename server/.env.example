# ---- Node API (api/.env), shared by all components ----
PORT=5001
MONGODB_URI=mongodb://localhost:27017/swara
SPEECH_SERVICE_URL=http://localhost:8010
SPEECH_TIMEOUT_MS=120000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
C1_JOB_CONCURRENCY=2
# 1 keeps uploaded audio after analysis (default: delete it)
C1_KEEP_UPLOADS=0
# Auth: signs session and parent-mode tokens; required when NODE_ENV=production
JWT_SECRET=change-me
# 0 lets requests without a token through (research scripts, curl); a sent token is still checked
AUTH_REQUIRED=1
AUTH_TOKEN_DAYS=7
PARENT_MODE_MINUTES=15
# Therapist accounts can register only with this code (empty: therapist sign-up is off)
THERAPIST_SIGNUP_CODE=
# Comma-separated origins, or * for any (development)
CORS_ORIGINS=*
# C2 (video secondary behaviours)
VISION_SERVICE_URL=http://localhost:8011
VISION_TIMEOUT_MS=300000
MAX_VIDEO_UPLOAD_MB=200
C2_JOB_CONCURRENCY=1
# 1 keeps uploaded videos after analysis (default: delete them)
C2_KEEP_UPLOADS=0
# How long a C2 job waits for its linked C1 assessment
C2_C1_WAIT_MS=600000
# Component 3 (adaptive therapy recommender)
# Policy: hybrid | discounted (sliding-window style discount on the per-child part)
C3_POLICY=hybrid
# UCB exploration weight
C3_ALPHA=0.6
# Discount per update for C3_POLICY=discounted (0-1; lower forgets faster)
C3_DISCOUNT_GAMMA=0.95
# Per-child prior strength λ (A = λI): larger keeps a new child closer to the population model for longer
C3_CHILD_PRIOR=5
# Share of picks made uniformly at random (logged with propensities for replay evaluation)
C3_EXPLORE_EPSILON=0
# Reward that updates the bandit: fused (0.6 P + 0.4 E) | performance | engagement | tap
C3_REWARD_MODE=fused
# Word check (uses LANGUAGE_SERVICE_URL below); the first call may wait for the ASR model to load
C3_WORD_CHECK_TIMEOUT_MS=60000
# Activities per therapy session (completed + skipped); the session ends after this many, or after the planned minutes
C3_MAX_ACTIVITIES=5

# Component 4 (language samples)
LANGUAGE_SERVICE_URL=http://localhost:8012
# ASR on CPU takes roughly real time on long samples; allow for the first model load too
LANGUAGE_TIMEOUT_MS=600000
C4_JOB_CONCURRENCY=1
# 1 keeps uploaded audio after analysis (default: delete it)
C4_KEEP_UPLOADS=0
# Samples that only build the starting vocabulary and the band baseline
C4_BASELINE_SESSIONS=3

# ---- C1 speech service (speech-service/.env) ----
# C1_DETECTOR=acoustic        # acoustic | xlsr (falls back to acoustic if unavailable)
# C1_MODEL_DIR=./models       # holds c1_head.joblib for xlsr
# C1_MAX_DURATION_SEC=180
# C1_MAX_CONCURRENT_ANALYSES=2

# ---- C2 vision service (vision-service/.env) ----
# C2_DETECTOR=srcd            # srcd (label-free) | rules | gru | transformer (learned ones fall back to srcd if unavailable)
# C2_MODEL_DIR=./models       # face_landmarker.task, and c2_srcd.pt for gru/transformer
# C2_TARGET_FPS=15
# C2_MAX_DURATION_SEC=180
# C2_NULL_ALPHA=0.05          # false-positive rate per category on the child's fluent speech
# C2_DEVIATION_THRESHOLD=3.0  # minimum deviation in SD
# C2_MIN_DEVIATION_SEC=0.3    # a deviation must hold this long
# C2_TAIL_PRIOR_SD=1.5
# C2_MAX_CONCURRENT_ANALYSES=2

# ---- C4 language service (language-service/.env) ----
# C4_ASR_ENGINE=ctc           # ctc | whisper | none (none: typed transcripts only)
# C4_CTC_MODEL=SpideyDLK/wav2vec2-large-xls-r-300m-sinhala-low-LR-part1   # Hugging Face id or local path
# C4_WHISPER_MODEL=SinhaSpeech/whisper-small-sinhala-run11
# C4_PRELOAD=0                # 1 loads the active engine in the background at startup
# C4_UTTERANCE_PAUSE_SEC=1.0
# C4_MAX_DURATION_SEC=300
# Word check for C3 (/verify-word); provisional thresholds, see C3_VERIFICATION_LOG.md
# C4_VERIFY_TEXT_MATCH=0.8
# C4_VERIFY_TEXT_MISMATCH=0.6
# C4_VERIFY_MARGIN=0.0
# C4_VERIFY_GOP_MATCH=0.4
# C4_VERIFY_GOP_MISMATCH=0.8
# C4_VERIFY_MIN_CONFIDENCE=0.3
# C4: allow mode=fixed sessions (the fixed-topic research arm); off = every session is personalised
C4_ALLOW_FIXED=0
