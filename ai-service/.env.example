# Swara AI Service Configuration
PORT=8000
HOST=0.0.0.0

# Component 1: Speech Analysis Settings
SPEECH_DEFAULT_EXTRACTOR=facebook/wav2vec2-xls-r-300m
SPEECH_FALLBACK_EXTRACTOR=facebook/wav2vec2-base
SPEECH_TARGET_SAMPLE_RATE=16000
SPEECH_WINDOW_DURATION_S=3.0
SPEECH_STEP_DURATION_S=1.5
SPEECH_MIN_DURATION_S=1.0
SPEECH_MAX_DURATION_S=300.0
SPEECH_MAX_FILE_SIZE_MB=25

# Severity & Syllable Thresholds (%SS)
SPEECH_SEVERITY_MILD_MAX_SS=3.0
SPEECH_SEVERITY_MODERATE_MAX_SS=8.0
SPEECH_LONG_EVENT_THRESHOLD_S=2.0

# Privacy: Clean up uploaded recordings after analysis (1 to keep for debugging, 0 to delete)
SPEECH_KEEP_UPLOADS=0
# Configure one local model directory. The service never downloads weights at runtime.
C4_MMS_ADAPTER_DIR=
C4_ASR_MODEL_DIR=
C4_ASR_MODEL_NAME=
C4_ASR_MODEL_VERSION=
C4_RECORDING_ROOT=
C4_MAX_AUDIO_BYTES=52428800
